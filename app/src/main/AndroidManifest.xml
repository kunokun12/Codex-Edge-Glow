<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="org.tessera.observer.permission.READ_EVIDENCE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <application android:label="Codex Companion" android:icon="@drawable/companion_icon" android:roundIcon="@drawable/companion_icon" android:theme="@android:style/Theme.Material.NoActionBar" android:allowBackup="false" android:supportsRtl="true">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity>
        <service android:name=".GlowService" android:exported="false" />
        <service android:name=".ScreenAccessService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice"
                android:resource="@xml/screen_accessibility" />
        </service>
        <!-- Candidate M7 observer: read-only, separate process, never enabled by this app. -->
        <service android:name=".fastpathv1.CandidateObserverAccessibilityServiceV1"
            android:process=":fastpath_observer"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:label="@string/fastpath_observer_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice"
                android:resource="@xml/fastpath_candidate_observer" />
        </service>
        <!-- Non-exported same-UID in-memory handoff; query-only. -->
        <provider android:name=".fastpathv1.CandidateObserverSnapshotProviderV1"
            android:authorities="com.codexedge.glow.observer.internal"
            android:process=":fastpath_observer"
            android:exported="false"
            android:grantUriPermissions="false" />
        <!-- DUMP-protected Fast Path v1 admission/control boundary; execution fails closed until release gates exist. -->
        <receiver android:name=".FastPathV1Receiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.codexedge.glow.FAST_PATH_V1" />
            </intent-filter>
        </receiver>
        <!-- Request-scoped, read-only Fast Path result API. -->
        <provider android:name=".FastPathResultProvider"
            android:authorities="com.codexedge.glow.fastpath"
            android:exported="true"
            android:readPermission="android.permission.DUMP"
            android:writePermission="android.permission.DUMP"
            android:grantUriPermissions="false" />
        <!-- Read-only diagnostic: no input or accessibility action permitted. -->
        <receiver android:name=".CompanionProbeReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.codexedge.glow.NATIVE_PROBE" />
            </intent-filter>
        </receiver>
        <!-- DUMP is held by the ADB shell, not ordinary third-party apps. -->
        <receiver android:name=".NativeActionReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.codexedge.glow.NATIVE_CLICK" />
            </intent-filter>
        </receiver>
        <receiver android:name=".GlowReceiver" android:exported="true" android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.codexedge.glow.START"/>
                <action android:name="com.codexedge.glow.STOP"/>
                <action android:name="com.codexedge.glow.PING"/>
                <action android:name="com.codexedge.glow.STATUS"/>
                <action android:name="com.codexedge.glow.TASK_ACQUIRE_V25"/>
                <action android:name="com.codexedge.glow.TASK_PING_V25"/>
                <action android:name="com.codexedge.glow.TASK_STOP_V25"/>
                <action android:name="com.codexedge.glow.TASK_READ_V25"/>
            </intent-filter>
        </receiver>
    </application>
</manifest>
