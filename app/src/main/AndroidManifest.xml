<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <application android:label="Codex Edge Glow" android:icon="@drawable/app_icon" android:theme="@android:style/Theme.Material.NoActionBar" android:allowBackup="false" android:supportsRtl="true">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity>
        <service android:name=".GlowService" android:exported="false" />
        <service android:name=".ScreenAccessService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice"
                android:resource="@xml/screen_accessibility" />
        </service>
        <receiver android:name=".GlowReceiver" android:exported="true">
            <intent-filter>
                <action android:name="com.codexedge.glow.START"/>
                <action android:name="com.codexedge.glow.STOP"/>
                <action android:name="com.codexedge.glow.PING"/>\n                <action android:name="com.codexedge.glow.STATUS"/>
            </intent-filter>
        </receiver>
    </application>
</manifest>
